@page "/autos"

@using KooliProjekt.BlazorWASM.Models
@using KooliProjekt.BlazorWASM.Api
@inject IApiClient ApiClient
@inject NavigationManager NavigationManager

<h3>Autod</h3>

<button class="btn btn-primary mb-3" @onclick="AddNew">
    Add new
</button>

@if (isLoading)
{
    <p>Laen andmeid...</p>
}
else if (errors.Any())
{
    <div class="alert alert-danger">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}
else if (autos.Count == 0)
{
    <p>Andmeid ei leitud.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tootja</th>
                <th>Mudel</th>
                <th>Numbrimark</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var auto in autos)
            {
                <tr>
                    <td>@auto.Id</td>
                    <td>@auto.Tootja</td>
                    <td>@auto.Mudel</td>
                    <td>@auto.Numbrimark</td>
                    <td>
                        <button class="btn btn-sm btn-secondary"
                                @onclick="() => Edit(auto.Id)">
                            Edit
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AutoModel> autos = new();
    private List<string> errors = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errors.Clear();

        var result = await ApiClient.GetAutosAsync();

        if (result.HasErrors)
        {
            errors.AddRange(result.Errors);

            foreach (var propertyError in result.PropertyErrors)
            {
                errors.AddRange(propertyError.Value);
            }

            autos = new List<AutoModel>();
        }
        else
        {
            autos = result.Value ?? new List<AutoModel>();
        }

        isLoading = false;
    }

    private void AddNew()
    {
        NavigationManager.NavigateTo("/autos/edit");
    }

    private void Edit(int id)
    {
        NavigationManager.NavigateTo($"/autos/edit/{id}");
    }
}